FROM rust:1.95-bookworm AS builder
WORKDIR /workspace
COPY . .
ARG RUST_PACKAGE=governance-api
RUN cargo build --release --locked -p "${RUST_PACKAGE}"

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ARG RUST_BINARY=governance-api
COPY --from=builder "/workspace/target/release/${RUST_BINARY}" /usr/local/bin/service
COPY apps/governance-api/config /app/apps/governance-api/config
WORKDIR /app/apps/governance-api
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/service"]
